rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Public catalogue: anyone can read, only admins can write.
    match /config/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /branches/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /products/{id}    { allow read: if true; allow write: if isAdmin(); }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // A new account always starts as a normal user with zero points.
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.points == 0
        && request.resource.data.totalOrders == 0
        && request.resource.data.totalSpent == 0
      );
      // Customers may edit their own details and spend (never add) points.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && !changes().hasAny(['role', 'totalOrders', 'totalSpent', 'blocked', 'createdAt', 'email'])
        && request.resource.data.points <= resource.data.points
        && request.resource.data.points >= 0
      );
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('pointsAwarded' in request.resource.data);
      // Customers may only cancel their own pending order (when no points were used).
      allow update: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && resource.data.pointsUsed == 0
        && request.resource.data.status == 'cancelled'
        && changes().hasOnly(['status', 'updatedAt', 'history'])
      );
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId in [request.auth.uid, 'all']);
      allow write: if isAdmin();
    }
  }
}
