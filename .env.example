# All optional.
# Set to "local" to build a browser-only demo (no PHP server needed).
NEXT_PUBLIC_BACKEND=php
# Set to "false" to allow using the app in a normal browser tab (no install required).
NEXT_PUBLIC_REQUIRE_PWA=true
# If the app lives in a sub-folder, e.g. https://example.com/food → /food
NEXT_PUBLIC_BASE_PATH=
