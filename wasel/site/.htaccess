# منصة واصل - كل الطلبات تروح لـ index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# تمرير ترويسة Authorization لـ PHP (تحتاجها واجهة API الخارجية)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# منع الوصول المباشر لملفات البيانات والكود
RewriteRule ^(data|lib|views|tools)(/|$) - [F,L]
RewriteRule ^(config|cron)\.php$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
</IfModule>
