# منصة واصل - كل الطلبات تروح لـ index.php
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# تمرير ترويسة Authorization لـ PHP (تحتاجها واجهة API الخارجية)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# مسار محرك واتساب (تطبيق Node.js من Setup Node.js App) - لا نلمسه
RewriteRule ^engine(/|$) - [L]

# منع الوصول المباشر لملفات البيانات والكود
RewriteRule ^(data|lib|views|tools|wasel-engine)(/|$) - [F,L]
RewriteRule ^(config|cron)\.php$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
</IfModule>
